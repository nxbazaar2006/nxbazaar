generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum UserRole {
  ADMIN
  USER
  SELLER
  MODERATOR
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum Language {
  EN
  HI
  MR
}

// ================= USER =================

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String?  @unique
  password      String
  emailVerified Boolean  @default(false)
  blogs         Blog[]
  vlogs         Vlog[]
  role          UserRole @default(USER)
  plan          String?
  status        Boolean  @default(true)

  verificationToken String?
  products          Product[]
  coupons           Coupon[]
  orders            Order[]
  sales             Sale[]
  vendorOrderItems  OrderItem[] @relation("VendorOrderItems")

  sellerProfile SellerProfile?
  profile       UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
}

// ================= PROFILE =================

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  firstName String?
  lastName  String?
  username  String? @unique
  phone     String?

  streetAddress String?
  city          String?
  district      String?
  state         String?
  country       String?
  zip           String?

  dateOfBirth  DateTime?
  profileImage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([city])
  @@index([state])
}

// ================= SELLER =================

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  code String? @unique
  approvalStatus SellerStatus @default(PENDING)

  contactPerson      String?
  contactPersonPhone String?

  phone           String?
  physicalAddress String?
  pickupAddress   String?
  city            String?
  state           String?
  country         String? @default("India")
  zip             String?

  businessName String?
  legalName    String?
  businessType String?
  gstNumber    String? @unique
  panNumber    String? @unique

  bankAccountName   String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankName          String?

  profileImageUrl String?
  notes           String?

  isActive Boolean @default(true)

  turnover    Float?
  mainProduct String?
  verifiedAt  DateTime?
  rejectedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus])
  @@index([isActive])
  @@index([businessName])
  @@index([phone])
}

// ================= CATEGORY =================

model Category {
  id String @id @default(uuid())

  imageUrl String?
  isActive Boolean @default(true)

  translations  CategoryTranslation[]
  subCategories SubCategory[]
  products      Product[]

  markets Market[] @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategoryTranslation {
  id          String   @id @default(uuid())
  locale      Language
  slug        String?
  title       String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

// ================= SUB CATEGORY =================

model SubCategory {
  id String @id @default(uuid())

  imageUrl String?
  isActive Boolean @default(true)

  translations SubCategoryTranslation[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  hsnCodeId String?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategoryTranslation {
  id            String      @id @default(uuid())
  locale        Language
  slug          String?
  title         String
  description   String?
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([subCategoryId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

// ================= MARKET =================

model Market {
  id String @id @default(uuid())

  title       String
  description String?
  logoUrl     String?

  isActive     Boolean             @default(true)
  translations MarketTranslation[]
  categories   Category[]          @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketTranslation {
  id String @id @default(uuid())

  locale      Language
  slug        String?
  title       String
  description String?
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketId, locale]) // same market + language duplicate na ho
  @@unique([locale, slug])
  @@index([locale, slug])
  @@index([locale])
}

// ================= HSN =================

model HsnCode {
  id      String @id @default(uuid())
  code    String @unique
  title   String
  gstRate Float

  products      Product[]
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([code])
}

// ================= PRODUCT =================

model Product {
  id       String  @id @default(uuid())
  title    String
  slug     String  @unique
  productCode String? @unique
  imageUrl String?

  tags String[]
  unit String?

  isActive    Boolean @default(true)
  isWholesale Boolean @default(false)

  currency String @default("INR")

  // 🔥 GST fallback (if no HSN)
  gstRate Float?

  images       ProductImage[]
  variants     ProductVariant[]
  translations ProductTranslation[]
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  hsnCodeId String?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])

  orderItems OrderItem[]
  sales      Sale[]
  blogs      Blog[]      @relation("BlogProducts")
  vlogs      Vlog[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([userId])
  @@index([userId, isActive])
}

model ProductHistory {
  id        String  @id @default(uuid())
  productId String

  productCode  String?
  productTitle String

  action String
  field  String?

  oldValue String?
  newValue String?

  variantId String?
  sku       String?

  changedByUserId   String?
  changedByUserCode String?
  changedByRole     String?
  sellerCode        String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([variantId])
  @@index([action])
  @@index([changedByUserId])
}

// ================= PRODUCT IMAGE =================

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ================= VARIANT =================

model ProductVariant {
  id        String @id @default(uuid())
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title String

  sku         String? @unique
  barcode     String? @unique
  barcodeUrl  String?
  productCode String?

  // 💰 Pricing
  price     Float
  salePrice Float?
  costPrice Float?

  currency String @default("INR")

  // 📦 Inventory
  stock          Int?
  reservedStock  Int     @default(0)
  lowStockAlert  Int?
  trackInventory Boolean @default(true)

  image String?

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  attributes       VariantAttribute[]
  wholesalePricing WholesalePricing[]

  // relations
  orderItems OrderItem[]
  sales      Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productCode])
}

// ================= ATTRIBUTES =================

model VariantAttribute {
  id        String @id @default(uuid())
  variantId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  name  String // size, color
  value String // M, Black
}

// ================= WHOLESALE =================

model WholesalePricing {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  minQty Int
  price  Float

  @@unique([variantId, minQty])
}

// ================= TRANSLATION =================

model ProductTranslation {
  id              String   @id @default(uuid())
  locale          Language
  slug            String?
  title           String
  description     String?
  metaTitle       String?
  metaDescription String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

model Vlog {
  id           String            @id @default(uuid())
  title        String
  productId    String?
  product      Product?          @relation(fields: [productId], references: [id])
  translations VlogTranslation[]
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  blogId       String?
  blog         Blog?             @relation(fields: [blogId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model VlogTranslation {
  id        String   @id @default(uuid())
  title     String
  slug      String?
  locale    Language
  vlogId    String
  vlog      Vlog     @relation(fields: [vlogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vlogId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

// ================= ORDER =================

model Order {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderNumber String @unique

  firstName String
  lastName  String
  email     String
  phone     String

  streetAddress String?
  city          String?
  state         String?
  country       String?
  zip           String?

  paymentMethod String
  orderStatus   OrderStatus @default(PENDING)

  shippingCost Float?

  orderItems OrderItem[]
  sales      Sale[]

  // 🔥 QR CODE (Order level)
  qrCodeUrl String? // image URL (S3/UploadThing)
  qrData    String? // URL जैसे: /order/{id}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
}

// ================= ORDER ITEM =================

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  vendorId         String
  vendor           User           @relation("VendorOrderItems", fields: [vendorId], references: [id])
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  title            String?
  imageUrl         String?

  quantity Int
  price    Float

  // 🔥 QR CODE (Item level)
  qrCodeUrl String?
  qrData    String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([productVariantId])
  @@index([createdAt])
}

// ================= SALE =================

model Sale {
  id String @id @default(uuid())

  orderId   String
  productId String
  vendorId  String

  total Float

  order            Order           @relation(fields: [orderId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  vendor           User            @relation(fields: [vendorId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([productVariantId])
  @@index([createdAt])
}

// ================= COUPON =================

model Coupon {
  id         String   @id @default(uuid())
  title      String
  couponCode String   @unique
  expiryDate DateTime
  isActive   Boolean  @default(true)

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([expiryDate])
  @@index([isActive])
}

// ================= BANNER =================

model Banner {
  id       String  @id @default(uuid())
  title    String
  link     String
  imageUrl String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id   String @id @default(uuid())
  slug String @unique

  imageUrl String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // 🔥 content (NO QUILL)
  content Json // markdown / rich json

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  translations BlogTranslation[]

  // 🔗 relation with product
  relatedProducts Product[] @relation("BlogProducts")
  vlogs           Vlog[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model BlogTranslation {
  id     String   @id @default(uuid())
  locale Language
  slug   String?

  title       String
  description String?

  metaTitle       String?
  metaDescription String?

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

model BlogCategory {
  id   String @id @default(uuid())
  slug String @unique

  title String

  blogs Blog[]
}
