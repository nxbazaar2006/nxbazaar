// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum UserRole {
  ADMIN
  USER
  SELLER
  MODERATOR
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum SlugModel {
  PRODUCT
  CATEGORY
  SUBCATEGORY
  MARKET
}

enum Language {
  EN
  HI
  MR
  TA
  TE
  KN
  GU
}

// ================= USER =================

model User {
  id            String   @id @default(uuid())
  name          String?
  email         String?  @unique
  password      String
  emailVerified Boolean  @default(false)
  blogs         Blog[]
  vlogs         Vlog[]
  role          UserRole @default(USER)
  plan          String?
  status        Boolean  @default(true)

  verificationToken String?

  products Product[]
  coupons  Coupon[]
  orders   Order[]
  sales    Sale[]

  sellerProfile SellerProfile?
  profile       UserProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ================= PROFILE =================

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  firstName String?
  lastName  String?
  username  String?
  phone     String?

  streetAddress String?
  city          String?
  district      String?
  state         String?
  country       String?
  zip           String?

  dateOfBirth  DateTime?
  profileImage String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ================= SELLER =================

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  code String? @unique

  contactPerson      String?
  contactPersonPhone String?

  phone           String?
  physicalAddress String?

  profileImageUrl String?
  notes           String?

  isActive Boolean @default(true)

  turnover    Float?
  mainProduct String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================= CATEGORY =================

model Category {
  id       String  @id @default(uuid())
  slug     String  @unique
  imageUrl String?
  isActive Boolean @default(true)

  translations  CategoryTranslation[]
  subCategories SubCategory[]
  products      Product[]

  markets Market[] @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model CategoryTranslation {
  id          String   @id @default(uuid())
  locale      Language
  slug        String?
  title       String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

// ================= SUB CATEGORY =================

model SubCategory {
  id       String  @id @default(uuid())
  slug     String  @unique
  imageUrl String?
  isActive Boolean @default(true)

  translations SubCategoryTranslation[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  hsnCodeId String?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model SubCategoryTranslation {
  id          String   @id @default(uuid())
  locale      Language
  slug        String?
  title       String
  description String?

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([subCategoryId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

// ================= MARKET =================

model Market {
  id          String  @id @default(uuid())
  slug        String  @unique
  title       String
  description String?
  logoUrl     String?

  isActive     Boolean             @default(true)
  translations MarketTranslation[]
  categories   Category[]          @relation("MarketCategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketTranslation {
  id String @id @default(uuid())

  locale      String // en, hi, mr
  slug        String?
  title       String
  description String?

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketId, locale]) // same market + language duplicate na ho
  @@unique([locale, slug])
  @@index([locale, slug])
  @@index([locale])
}

// ================= HSN =================

model HsnCode {
  id      String @id @default(uuid())
  code    String @unique
  title   String
  gstRate Float

  products      Product[]
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([code])
}

// ================= PRODUCT =================

model Product {
  id       String  @id @default(uuid())
  title    String
  slug     String  @unique
  imageUrl String?

  tags String[]
  unit String?

  isActive    Boolean @default(true)
  isWholesale Boolean @default(false)

  currency String @default("INR")

  images       ProductImage[]
  variants     ProductVariant[]
  translations ProductTranslation[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  hsnCodeId String?
  hsnCode   HsnCode? @relation(fields: [hsnCodeId], references: [id])

  orderItems OrderItem[]
  sales      Sale[]
  blogs      Blog[]      @relation("BlogProducts")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([userId])
}

// ================= PRODUCT IMAGE =================

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ================= VARIANT =================

model ProductVariant {
  id        String @id @default(uuid())
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title String

  sku     String? @unique
  barcode String? @unique

  price     Float
  salePrice Float?
  costPrice Float?

  currency String @default("INR")

  stock          Int?
  reservedStock  Int     @default(0)
  lowStockAlert  Int?
  trackInventory Boolean @default(true)

  image String?

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  attributes       VariantAttribute[]
  wholesalePricing WholesalePricing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ================= ATTRIBUTES =================

model VariantAttribute {
  id        String @id @default(uuid())
  variantId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  name  String
  value String
}

// ================= WHOLESALE =================

model WholesalePricing {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  minQty Int
  price  Float

  @@unique([variantId, minQty])
}

// ================= TRANSLATION =================

model ProductTranslation {
  id          String   @id @default(uuid())
  locale      Language
  slug        String?
  title       String
  description String?

  metaTitle       String?
  metaDescription String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}


model Vlog {
  id           String            @id @default(uuid())
  title        String
  productId    String?
  product      Product?          @relation(fields: [productId], references: [id])
  translations VlogTranslation[]
  userId       String?
  user         User?             @relation(fields: [userId], references: [id])
  blogId       String?
  blog         Blog?             @relation(fields: [blogId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model VlogTranslation {
  id        String   @id @default(uuid())
  title     String
  slug      String
  locale    Language
  vlogId    String
  vlog      Vlog     @relation(fields: [vlogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
}

// ================= ORDER =================

model Order {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderNumber String @unique

  firstName String
  lastName  String
  email     String
  phone     String

  streetAddress String?
  city          String?
  state         String?
  country       String?
  zip           String?

  paymentMethod String
  orderStatus   OrderStatus @default(PENDING)

  shippingCost Float?

  orderItems OrderItem[]
  sales      Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================= ORDER ITEM =================

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  vendorId String

  title    String?
  imageUrl String?

  quantity Int
  price    Float
}

// ================= SALE =================

model Sale {
  id String @id @default(uuid())

  orderId   String
  productId String
  vendorId  String

  total Float

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  vendor    User     @relation(fields: [vendorId], references: [id])
  createdAt DateTime @default(now())
}

// ================= COUPON =================

model Coupon {
  id         String   @id @default(uuid())
  title      String
  couponCode String   @unique
  expiryDate DateTime
  isActive   Boolean  @default(true)

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// ================= BANNER =================

model Banner {
  id       String  @id @default(uuid())
  title    String
  link     String
  imageUrl String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id   String @id @default(uuid())
  slug String @unique

  imageUrl String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // 🔥 content (NO QUILL)
  content Json // markdown / rich json

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  translations BlogTranslation[]

  // 🔗 relation with product
  relatedProducts Product[] @relation("BlogProducts")

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model BlogTranslation {
  id     String   @id @default(uuid())
  locale Language
  slug   String?

  title       String
  description String?

  metaTitle       String?
  metaDescription String?

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, locale])
  @@unique([locale, slug])
  @@index([locale, slug])
}

model BlogCategory {
  id   String @id @default(uuid())
  slug String @unique

  title String

  blogs Blog[]
}
